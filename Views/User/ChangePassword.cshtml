@model MyApp.Models.UserDto;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.HiddenFor(m => m.UserGuid);
<div class="container">
    <div class="page-inner">
        @using (Html.BeginForm("ChangePassword", "User", FormMethod.Post))
        {

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Change Password</div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 ">
                                    <div class="form-group">
                                        <label for="username"><span class="mandatory">*</span>Password</label>
                                        @Html.TextBoxFor(m => m.Password, new { @class = "form-control form-control-sm", @placeholder = "Password", @type = "password" })
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="card-action">
                            <button type="button" class="btn btn-success" id="changepassword" >Update</button>
                            <button type="button" class="btn btn-danger" id="cancel">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script src="~/myapp.js/User.js?var=@DateTime.Now"></script>