@model MyApp.Models.CattleFeedTGTDto;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.HiddenFor(m => m.CattleFeedGuid);

<div class="container">
    <div class="page-inner">
        @using (Html.BeginForm("Save", "User", FormMethod.Post))
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Cattel Feed Target </div>
                        </div>

                        <div class="card-body">
                            <div class="row">
                                
                                    <div class="table-responsive table-container">
                                    <table id="cattlefeedetable" class="table  table-hover fixed-header-table">
                                            <thead>
                                                <tr>
                                                <th>Code</th>
                                                <th>Plant Code</th>
                                                <th>Plant Name</th>
                                                <th>From Date</th>
                                                <th>To Date</th>
                                                <th>Week No</th>
                                                <th>Target</th>
                                                </tr>

                                            </thead>
                                            <tbody id="cattlefeedvaluebody"></tbody>
                                        </table>
                                    </div>
                            </div>
                        </div>
                      
                        <div class="card-action">
                            @if (Model.CattleFeedGuid != Guid.Empty)
                            {
                                <button type="button" class="btn btn-success" id="save">@ViewBag.Button</button>
                                <button type="button" class="btn btn-danger" id="cancel">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success" id="savelist">Submit</button>
                                <button type="button" class="btn btn-danger" id="cancel">Cancel</button>
                            }

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/myapp.js/CattleFeedTGT.js?var=@DateTime.Now"></script>



