@model MyApp.Models.EmployeeDto;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.HiddenFor(m=>m.EmployeeGuid);

<div class="container">
    <div class="page-inner">
        @using (Html.BeginForm("Save", "Employee", FormMethod.Post))
        {

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Employee Registration</div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 ">
                                    <div class="form-group">
                                        <label for="password"><span class="mandatory">*</span>Emp Code</label>
                                        @Html.TextBoxFor(m => m.EmployeeCode, new { @class = "form-control form-control-sm", @placeholder = "Emp Code", onfocusout = "return ChkEmpCode()" })
                                    </div>
                                    <div class="form-group">
                                        <label for="areaname" class="confi-label"><span class="mandatory">*</span>Joining Date </label>
                                        <div class="datepicker date input-group">
                                            @Html.TextBoxFor(model => model.DateofJoining, "{0:dd/MM/yyyy}", new { @class = "form-control form-control-sm", @maxlength = "100", @placeholder = "Admission Date" })
                                            <div class="input-group-append calend-pos">
                                                <span class="input-group-text"> <img src="~/img/calendar_icon.svg" class="cal-h "></span>
                                            </div>

                                        </div>
                                    </div>
                                   
                                    <div class="form-group">
                                        <label for="areaname" class="confi-label"> Leaving Date </label>
                                        <div class="datepicker date input-group">
                                            @Html.TextBoxFor(model => model.Dateofleaving, "{0:dd/MM/yyyy}", new { @class = "form-control form-control-sm", @maxlength = "100", @placeholder = "Leaving Date" })
                                            <div class="input-group-append calend-pos">
                                                <span class="input-group-text"> <img src="~/img/calendar_icon.svg" class="cal-h "></span>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="password"><span class="mandatory">*</span>Emp Name</label>
                                        @Html.TextBoxFor(m => m.EmployeeName, new { @class = "form-control form-control-sm", @placeholder = "Emp Name" })
                                    </div>
                                    <div class="form-group">
                                        <label for="password">Manager</label>
                                        @Html.DropDownListFor(m => m.ManagerId, new SelectList(ViewBag.ManagerId, "Value", "Text"), new { @class = "form-control form-control-sm form-control-sm js-example-basic-single" })
                                    </div>
                                    <div class="form-group">
                                        <label for="password">Active</label><br />
                                        @if(Model.EmployeeGuid != Guid.Empty)
                                        {
                                            @Html.CheckBoxFor(m => m.IsActive)
                                        }
                                        else
                                        {
                                            @Html.CheckBoxFor(m => m.IsActive,new {@disabled="disabled"})
                                        }

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="password"><span class="mandatory">*</span>Designation</label>
                                        
                                            @Html.DropDownListFor(m => m.DesignationId, new SelectList(ViewBag.DesiganationId, "Value", "Text"), new { @class = "form-control form-control-sm js-example-basic-single" })
                                    
                                    </div>

                                    <div class="form-group">
                                        <label for="password"><span class="mandatory">*</span>Tableau Designation</label>
                                        @Html.DropDownListFor(m => m.TableauDesignationId, new SelectList(ViewBag.TableauDesignationId, "Value", "Text"), new { @class = "form-control form-control-sm form-control-sm js-example-basic-single" })
                                    </div>
                                       

                                </div>

                            </div>
                        </div>
                        <div class="card-action">
                            <button type="button" class="btn btn-success" id="saveEmployee">@ViewBag.Button</button>
                            <button type="button" class="btn btn-danger" id="cancel">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/myapp.js/Employee.js?var=@DateTime.Now"></script>


