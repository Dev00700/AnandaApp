        </table>*@

                            <table class="display table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Emp Code</th>
                                        <th>Emp Name</th>
                                        <th>Desig Id</th>
                                        <th>tabelue id</th>
                                        <th>manager id</th>
                                        <th>date of joining</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        foreach (var item in Model)
                                        {



                                            <tr>
                                                <td>@item.EmployeeCode</td>
                                                <td>@item.EmployeeName</td>
                                                <td>@item.DesignationId</td>
                                                <td>@item.TableauDesignationId</td>
                                                <td>@item.ManagerId</td>
                                                <td>@item.DateofJoining</td>
                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                            <div class="pagination">
                                @if (Model.HasPreviousPage)
                                {
                                    <a href="@Url.Action("Index", new { page = Model.PageNumber - 1 })">Previous</a>
                                }

                                @if (Model.PageCount > 1)
                                {
                                    <!-- First Page -->
                                    @if (Model.PageNumber > 3)
                                    {
                                        <a href="@Url.Action("Index", new { page = 1 })">1</a>
                                        <span>...</span>
                                    }

                                    <!-- Show Current Page and Two Neighbors -->
                                    @for (int i = Math.Max(1, Model.PageNumber - 1); i <= Math.Min(Model.PageCount, Model.PageNumber + 1); i++)
                                    {
                                        <a href="@Url.Action("Index", new { page = i })" class="@(i == Model.PageNumber ? "active" : "")">@i</a>
                                    }

                                    <!-- Ellipsis for Pages in Between -->
                                    @if (Model.PageNumber < Model.PageCount - 2)
                                    {
                                        <span>...</span>
                                        <a href="@Url.Action("Index", new { page = Model.PageCount })">@Model.PageCount</a>
                                    }
                                }

                                @if (Model.HasNextPage)
                                {
                                    <a href="@Url.Action("Index", new { page = Model.PageNumber + 1 })">Next</a>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </div>


        </div>


    </div>
</div>


@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
