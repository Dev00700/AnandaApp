@model IPagedList<MyApp.Models.EmployeeDto>;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using X.PagedList;
<style>
    .pagination a {
        margin: 0 5px;
        padding: 5px 10px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: #007bff;
    }

        .pagination a.active {
            background-color: #007bff;
            color: white;
            font-weight: bold;
        }

    .pagination span {
        margin: 0 5px;
        padding: 5px 10px;
        color: #777;
    }

</style>

<div class="container">
    <div class="page-inner">

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Basic</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            @*<table id="basic-datatables"
               class="display table table-striped table-hover">
            <thead>
                <tr>
                    <th>Emp Code</th>
