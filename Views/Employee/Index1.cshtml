                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {



                        <tr>
                            <td>@item.EmployeeCode</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.DesignationId</td>
