    <script>
        function SuccessMsg(message,url) {
            debugger;
            swal(message, {
                buttons: {
                    confirm: {
                        className: "btn btn-success",
                    },
                },
            }).then((s) => {
                location.href = url;
            });
        }
        function ErrorMsg(message) {
            debugger;
            swal(message, {
                buttons: {
                    confirm: {
                        className: "btn btn-danger",
                    },
                },
            });
        }
        function WarningMsg(message) {
            swal(message, {
                icon: "warning",
                buttons: {
                    confirm: {
                        className: "btn btn-warning",
                    },
                },
            });
        }
      
        function GetCurrentDate(){
            const currentDate = new Date();
            const formattedDate =
                ('0' + currentDate.getDate()).slice(-2) + '/' +        // Day (2 digits)
                ('0' + (currentDate.getMonth() + 1)).slice(-2) + '/' + // Month (2 digits)
                currentDate.getFullYear();                             // Year (4 digits)
            return formattedDate;
        }

        
    </script>
