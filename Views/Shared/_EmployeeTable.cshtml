@model IPagedList<MyApp.Models.EmployeeDto>;
@using X.PagedList;
<div class="table-responsive">
    <table class="table table-striped table-hover ">
        <thead>
            <tr>
                <th>
                    <input type="text"  class="form-control filter-input form-control-sm txtfilter" data-column="empCode" placeholder="Emp Code" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="empName" placeholder="Emp Name" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="designation" placeholder="Designation" />
                </th>
                <th></th>
                <th></th>
                <th></th>
              @*   <th>
                    <input id="filterchk"  type="checkbox" data-toggle="switchbutton" checked data-onstyle="outline-success" checked data-size="xs" data-offstyle="outline-danger"
                           checked data-onlabel="A" data-offlabel="I">
                       </th> *@
            </tr>
            <tr class="table-head-bg-success">
               
                <th>Emp Code</th>
                <th>Emp Name</th>
                <th>Designation</th>
                <th>Tableau</th>
                <th>Manager</th>
                <th>DOJ</th>
                <th>Active</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeCode</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.DesignationName</td>
                        <td>@item.TablueName</td>
                        <td>@item.ManagerName</td>
                        <td>@item.DateofJoining</td>
                       
                        <td>@if (item.Status == "Active")
                            {
                                <Text><span class="badge badge-success">Active</span></Text>
                            }
                            else
                            {
                                <text><span class="badge badge-danger">InActive</span></text>
                            }
                        </td>
                        <td><a asp-action="Save" asp-route-id="@item.EmployeeGuid"><i class="fa fa-edit"></i></a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="pagination-wrapper">
    <!-- Pagination on the left -->
    <div class="pagination">
        @if (Model.HasPreviousPage)
        {
            <a href="javascript:void(0);" class="page-link" data-page="@Convert.ToInt32(Model.PageNumber - 1)"><i class="fas fa-angle-left"></i></a>
        }

        @if (Model.PageCount > 1)
        {
            <!-- First Page -->
            @if (Model.PageNumber > 3)
            {
                <a href="javascript:void(0);" class="page-link" data-page="1">1</a>
                <span>...</span>
            }

            <!-- Show Current Page and Two Neighbors -->
            @for (int i = Math.Max(1, Model.PageNumber - 1); i <= Math.Min(Model.PageCount, Model.PageNumber + 1); i++)
            {
                <a href="javascript:void(0);" data-page="@i" class="page-link @(i == Model.PageNumber ? "active" : "")">@i</a>
            }

            <!-- Ellipsis for Pages in Between -->
            @if (Model.PageNumber < Model.PageCount - 2)
            {
                <span>...</span>
                <a href="javascript:void(0);" data-page="@Model.PageCount">@Model.PageCount</a>
            }
        }

        @if (Model.HasNextPage)
        {
            <a href="javascript:void(0);" class="page-link" data-page="@Convert.ToInt32(Model.PageNumber + 1)"><i class="fas fa-angle-right"></i></a>
        }
    </div>

    <!-- Rows per page dropdown on the right -->
    <div class="pagination-container">
        <div class="rows-per-page">
            <select id="rowsPerPage" class="form-select form-select-sm" style="width: auto; display: inline-block;">
                @foreach (var size in new[] { 10, 25, 50, 100 })
                {
                    <option value="@size">@size</option>
                }
            </select>

        </div>
    </div>
</div>
