@model IPagedList<MyApp.Models.ProductCategoryDto>;
@using X.PagedList;
<div class="table-responsive">
    <table class="table table-striped table-hover ">
        <thead>
            <tr>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="ProductCategoryCode" placeholder="Category Code" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="ProductType" placeholder="Product Type" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="ZMGRP" placeholder="ZMGRP" />
                </th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
            <tr class="table-head-bg-success">
                <th>Category Code</th>
                <th>Product Type</th>
                <th>ZMGRP</th>
                <th>ZSGRP1</th>
                <th>Active</th>
                 @if (ViewBag.Edit != null && ViewBag.Edit == true)
            {
                <th>Action</th>
            }
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductCategoryCode</td>
                        <td>@item.ProductType</td>
                        <td>@item.ZMGRP</td>
                        <td>@item.ZSGRP1</td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <Text><span class="badge badge-success">Active</span></Text>
                            }
                            else
                            {
                                <text><span class="badge badge-danger">InActive</span></text>
                            }
                        </td>
                        <td>
                            @if (ViewBag.Edit != null && ViewBag.Edit == true)
                            {
                            <a asp-action="Save" asp-route-id="@item.ProductCategoryGuid"><i class="fa fa-edit"></i></a>
                            }    
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="pagination-wrapper">
    <!-- Pagination on the left -->
    <div class="pagination">
        @if (Model.HasPreviousPage)
        {
            <a href="javascript:void(0);" class="page-link" data-page="@Convert.ToInt32(Model.PageNumber - 1)"><i class="fas fa-angle-left"></i></a>
        }

        @if (Model.PageCount > 1)
        {
            <!-- First Page -->
            @if (Model.PageNumber > 3)
            {
                <a href="javascript:void(0);" class="page-link" data-page="1">1</a>
                <span>...</span>
            }

            <!-- Show Current Page and Two Neighbors -->
            @for (int i = Math.Max(1, Model.PageNumber - 1); i <= Math.Min(Model.PageCount, Model.PageNumber + 1); i++)
            {
                <a href="javascript:void(0);" data-page="@i" class="page-link @(i == Model.PageNumber ? "active" : "")">@i</a>
            }

            <!-- Ellipsis for Pages in Between -->
            @if (Model.PageNumber < Model.PageCount - 2)
            {
                <span>...</span>
                <a href="javascript:void(0);" data-page="@Model.PageCount">@Model.PageCount</a>
            }
        }

        @if (Model.HasNextPage)
        {
            <a href="javascript:void(0);" class="page-link" data-page="@Convert.ToInt32(Model.PageNumber + 1)"><i class="fas fa-angle-right"></i></a>
        }
    </div>

    <!-- Rows per page dropdown on the right -->
    <div class="pagination-container">
        <div class="rows-per-page">
            <select id="rowsPerPage" class="form-select form-select-sm" style="width: auto; display: inline-block;">
                @foreach (var size in new[] { 10, 25, 50, 100 })
                {
                    <option value="@size">@size</option>
                }
            </select>

        </div>
    </div>
</div>

