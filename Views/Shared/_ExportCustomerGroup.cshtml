@model IPagedList<MyApp.Models.ExportCustomerGroupDto>;
@using X.PagedList;
<div class="table-responsive">
    <table class="table table-striped table-hover ">
        <thead>
            <tr>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="custCode" placeholder="Customer Code" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="division" placeholder="Division" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="dic" placeholder="DIC" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="line_DET" placeholder="Line DET" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="Line_Type" placeholder="Line Type" />
                </th>
                <th>
                    <input type="text" class="form-control filter-input form-control-sm txtfilter" data-column="Line_Type2" placeholder="Line Type2" />
                </th>

            </tr>
            <tr class="table-head-bg-success">

            <tr>
                <th>Customer Code</th>
                <th>Division</th>
                <th>DIC</th>
                <th>Line DET</th>
                <th>Line_Type</th>
                <th>Line_Type2</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>

        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var user in Model)
                {
                    <tr>
                        <td>@user.CustCode</td>
                        <td>@user.Division</td>
                        <td>@user.DIC</td>
                        <td>@user.Line_DET</td>
                        <td>@user.Line_Type</td>
                        <td>@user.Line_Type2</td>

                        <td>
                            @if (user.Status == "Active")
                            {
                                <Text><span class="badge badge-success">Active</span></Text>
                            }
                            else
                            {
                                <text><span class="badge badge-danger">InActive</span></text>
                            }
                        </td>
                        <td><a asp-action="Save" asp-route-id="@user.ExportCustGrpGuid"><i class="fa fa-edit"></i></a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="pagination">
    @if (Model.HasPreviousPage)
    {
        <a href="javascript:void(0);" class="page-link" data-page="@Convert.ToInt32(Model.PageNumber - 1)">Previous</a>
    }

    @if (Model.PageCount > 1)
    {
        <!-- First Page -->
        @if (Model.PageNumber > 3)
        {
            <a href="javascript:void(0);" class="page-link" data-page="1">1</a>
            <span>...</span>
        }

        <!-- Show Current Page and Two Neighbors -->
        @for (int i = Math.Max(1, Model.PageNumber - 1); i <= Math.Min(Model.PageCount, Model.PageNumber + 1); i++)
        {
            <a href="javascript:void(0);" data-page="@i" class="page-link @(i == Model.PageNumber ? "active" : "")">@i</a>
        }

        <!-- Ellipsis for Pages in Between -->
        @if (Model.PageNumber < Model.PageCount - 2)
        {
            <span>...</span>
            <a href="javascript:void(0);" data-page="@Model.PageCount">@Model.PageCount</a>
        }
    }

    @if (Model.HasNextPage)
    {
        <a href="javascript:void(0);" class="page-link" data-page="@Convert.ToInt32(Model.PageNumber + 1)">Next</a>
    }
</div>
