@model MyApp.Models.UserMenuAuthorizationDto;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.HiddenFor(m => m.UserMenuGuid);
@Html.HiddenFor(m => m.UserMenuId);
<div class="container">
    <div class="page-inner">
        @using (Html.BeginForm("Save", "Employee", FormMethod.Post))
        {
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                                <h4 class="card-title">User Menu</h4>
                                @Html.DropDownListFor(m => m.UserId, new SelectList(ViewBag.UserDetails, "Value", "Text"), new { @id = "dropdown-select", @class = "form-control form-control-sm form-control-sm js-example-basic-single" })

                            </div>

                        </div>


                    </div>

                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover ">
                    <thead>
                        <tr class="table-head-bg-success">
                            <th>Sr No</th>
                            <th class="text-center">
                                <input type="checkbox" id="selectAllIsActive" />
                            </th>
                            <th>Menu Code</th>
                            <th>Menu Name</th>
                            <th>For Add</th>
                            <th>For Edit</th>
                            <th></th>
                            <th></th>
                            <th></th>


                        </tr>
                    </thead>
                    <tbody id="tblBody">
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<div class="card-action">
    <button type="button" class="btn btn-success" onclick="return Validation();" id="saveUserMenu">@ViewBag.Button</button>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="~/myapp.js/UserMenu.js"></script>