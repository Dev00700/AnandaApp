@model MyApp.Models.UserMenuAuthorizationDto;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.HiddenFor(m => m.UserMenuGuid);
@Html.HiddenFor(m => m.UserMenuId);
<div class="container">
    <div class="page-inner">
        @using (Html.BeginForm("Save", "Employee", FormMethod.Post))
        {
            <div class="row">
            <div class="col-md-12">
                    <div class="card">
                <div class="card-header">
                            <div class="card-header">
                                <div class="card-title">Menu Authorization </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                        <div class="col-md-4">
                              
                            </div>
                        <div class="col-md-4">
                                    <label for="username">User</label>
                            @Html.DropDownListFor(m => m.UserId, new SelectList(ViewBag.UserDetails, "Value", "Text"), new { @id = "dropdown-select", @class = "form-control form-control-sm form-control-sm js-example-basic-single" })

                        </div>
                        <div class="col-md-4">
                        </div>








                                <div class="table-responsive table-container">
                <table class="table table-striped table-hover ">
                    <thead>
                        <tr class="table-head-bg-success">
                            <th>Sr No</th>
                            <th class="text-center">
                                <input type="checkbox" id="selectAllIsActive" />
                            </th>
                            <th>Menu Code</th>
                            <th>Menu Name</th>
                            <th>Add</th>
                            <th>Edit</th>
                            <th></th>
                            <th></th>
                            <th></th>


                        </tr>
                    </thead>
                    <tbody id="tblBody">
                    </tbody>
                </table>
            </div>
                        </div>
                </div>
                        <div class="card-action">
                            <button type="button" class="btn btn-success" onclick="return Validation();" id="saveUserMenu">@ViewBag.Button</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script src="~/myapp.js/UserMenu.js"></script>