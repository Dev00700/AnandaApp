@model MyApp.Models.UserDto;
@{
    Layout = null;
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dairy Project Login</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: url('/img/login.webp') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Arial', sans-serif;
        }

        .login-card {
            background-color: rgba(255, 255, 255, 0.8); /* Transparent White */
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #28a745;
        }

        .btn-success {
            border-radius: 50px;
            background-color: #28a745;
            border: none;
        }

            .btn-success:hover {
                background-color: #218838;
            }

        .form-label {
            font-weight: bold;
        }

        .login-heading {
            font-size: 2rem;
            font-weight: bold;
            color: #343a40;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>

<body>
   @using (Html.BeginForm("Login", "Login", FormMethod.Post)) {

               
            <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card login-card">
            <h2 class="login-heading text-center mb-4">Login</h2>
            <form>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                   
                    @Html.TextBoxFor(m=>m.UserName,new { @class = "form-control", @placeholder = "Enter your username", @required= "required" })
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                   @* <input type="password" class="form-control" id="password" placeholder="Enter your password" required>*@
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Enter your password", @required = "required" })
                </div>
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    
                    <a href="#" class="text-decoration-none">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-success w-100 py-2">Login</button>

            </form>
        </div>
    </div>
    }
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    
</body>

</html>


